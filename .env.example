# Base URL for the Express API. Leave as /api during development — the Vite
# dev server proxies it to the backend (see vite.config.js), which keeps the
# session cookie same-origin. Only change this for a production deployment
# where the React build is NOT served by the same Express app.
VITE_API_BASE_URL=/api

# ---------- Push notifications ----------
# Nothing to configure here. Push notifications use the standard Web Push
# API + VAPID: the backend generates and persists its own VAPID key pair
# automatically on first run (see Backend/vapid-keys.json, gitignored) and
# the frontend fetches the public key at runtime from
# GET /api/push/vapid-public-key — there's no build-time secret or
# third-party account needed. See Frontend/PUSH_NOTIFICATIONS_SETUP.md.
